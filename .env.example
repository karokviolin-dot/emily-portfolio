# ------------------------------------------------------------------
# Site
# ------------------------------------------------------------------
# Full production URL, no trailing slash. Used for canonical links,
# Open Graph tags, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ------------------------------------------------------------------
# Personal / brand
# ------------------------------------------------------------------
NEXT_PUBLIC_FULL_NAME="Alexandra Reyes"

# ------------------------------------------------------------------
# Contact
# ------------------------------------------------------------------
NEXT_PUBLIC_EMAIL=hello@your-domain.com

# WhatsApp number in international format, digits only (no +, spaces or dashes)
NEXT_PUBLIC_WHATSAPP_NUMBER=15551234567

NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/discovery-call
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/your-handle

# ------------------------------------------------------------------
# Analytics (all optional — leave blank to disable)
# ------------------------------------------------------------------
# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML tag verification code
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Microsoft Clarity project ID
NEXT_PUBLIC_CLARITY_ID=

# Meta Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=
